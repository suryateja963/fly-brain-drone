#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"

WorldInfo {
  info [
    "Phase 0 and Phase 1 world for the fly-brain drone."
    "Empty except for a textured floor: nothing to collide with, and enough"
    "floor texture to generate optic flow once Phase 2 needs it."
    "The drone MUST start at the origin — Phase 1's exit test is the flight"
    "to the target, so a start position saved mid-flight invalidates the run."
  ]
  title "Fly-Brain Drone - 01 empty"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.1 -0.02 0.995 2.9
  position 6.5 -2.0 2.2
  near 0.2
  follow "Mavic 2 PRO"
  followSmoothness 0.2
}
TexturedBackground {
  luminosity 3
}
TexturedBackgroundLight {
}
Floor {
  size 100 100
  tileSize 2 2
  appearance Parquetry {
    type "chequered"
  }
}
Mavic2Pro {
  translation 0 0 0.1
  rotation 0 0 1 0
  controller "fly_brain"
  cameraSlot [
    Camera {
      width 400
      height 240
      near 0.2
    }
  ]
}
