WorldInfo {
  info [
    "Enclosed room, dense random clutter. Stress test."
    "Walls on all four sides mean no escape route: the drone must"
    "genuinely navigate rather than drift out of trouble."
  ]
  title "Fly-Brain Drone - 05 cluttered room"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
