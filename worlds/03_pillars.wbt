WorldInfo {
  info [
    "Pillar forest -- the demo centrepiece."
    "Drone flies through using optic flow alone: expansion difference"
    "steers, total expansion brakes. No map, no planner, no learning."
  ]
  title "Fly-Brain Drone - 03 pillar forest"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
