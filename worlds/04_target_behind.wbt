WorldInfo {
  info [
    "Obstacles placed directly between start and target (5, 3)."
    "Tests ARBITRATION: the sigmoid blend must dodge and still arrive."
    "A hard switch here produces a dodge-return limit cycle."
  ]
  title "Fly-Brain Drone - 04 target behind obstacles"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.25 -0.05 0.97 2.6
  position 6.5 -8.0 6.0
  near 0.2
  follow "Mavic 2 PRO"
  followSmoothness 0.2
}
TexturedBackground {
  luminosity 3
}
