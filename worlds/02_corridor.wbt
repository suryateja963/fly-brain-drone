#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Roughcast.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"

WorldInfo {
  info [
    "Corridor with textured walls. Tests the centring response:"
    "balanced expansion left and right holds the drone mid-channel."
    "Walls are Roughcast textured -- a blank wall yields NO optic flow."
  ]
  title "Fly-Brain Drone - 02 corridor"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.25 -0.05 0.97 2.6
  position 6.5 -8.0 6.0
  near 0.2
  follow "Mavic 2 PRO"
  followSmoothness 0.2
}
TexturedBackground {
  luminosity 3
}
TexturedBackgroundLight {
}
Floor {
  size 100 100
  tileSize 2 2
  appearance Parquetry {
    type "chequered"
  }
}
Solid {
  translation 6.0 2.2 1.5
  rotation 0 0 1 0.0
  name "wall_left"
  children [
    Shape {
      appearance Roughcast {
        colorOverride 0.82 0.78 0.72
        textureTransform TextureTransform {
          scale 4 3
        }
      }
      geometry Box {
        size 14.0 0.3 3.0
      }
    }
  ]
  boundingObject Box {
    size 14.0 0.3 3.0
  }
}
Solid {
  translation 6.0 -2.2 1.5
  rotation 0 0 1 0.0
  name "wall_right"
  children [
    Shape {
      appearance Roughcast {
        colorOverride 0.82 0.78 0.72
        textureTransform TextureTransform {
          scale 4 3
        }
      }
      geometry Box {
        size 14.0 0.3 3.0
      }
    }
  ]
  boundingObject Box {
    size 14.0 0.3 3.0
  }
}
Mavic2Pro {
  translation 0 0 0.1
  rotation 0 0 1 0
  controller "fly_brain"
  extensionSlot [
    Camera {
      name "forward_camera"
      translation 0.1 0 0
      rotation 0 1 0 0
      width 400
      height 240
      fieldOfView 1.2
      near 0.05
    }
  ]
  cameraSlot [
    Camera {
      width 400
      height 240
      near 0.2
    }
  ]
}
